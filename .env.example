# Copia este archivo a .env y completa los valores. .env NUNCA se sube a Git.
# Cada sitio usa variables con su prefijo: <SITIO>_BASE_URL, <SITIO>_USER, <SITIO>_PASSWORD.

# web/saucedemo
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USER=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Solo para CI o para el Agent SDK (en local Claude Code usa tu sesión):
ANTHROPIC_API_KEY=

# api/petstore (API pública compartida, solo GET)
PETSTORE_BASE_URL=https://petstore3.swagger.io/api/v3
# Opcional: la spec declara api_key, pero el demo no la exige. Nunca pongas un valor real aquí.
PETSTORE_API_TOKEN=
